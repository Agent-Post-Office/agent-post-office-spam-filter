{
  "name": "@agent-post-office/spam-filter",
  "version": "0.2.0",
  "description": "Worker-safe additive email spam scorer used by Agent Post Office. Pure TypeScript, no required runtime dependencies. Optional SpamAssassin rule subpath.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Agent Post Office",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agent-Post-Office/agent-post-office-spam-filter.git"
  },
  "keywords": [
    "spam",
    "email",
    "cloudflare-workers",
    "authentication-results",
    "dmarc",
    "phishing",
    "spamassassin"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "NOTICE",
    "vendor/spamassassin/sources.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spamassassin": {
      "types": "./dist/spamassassin/index.d.ts",
      "import": "./dist/spamassassin/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sa:verify": "node scripts/sa/verify.mjs",
    "eval": "npm run build && node scripts/eval.mjs",
    "eval:public": "npm run build && node scripts/eval-public.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/eval.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "htmlparser2": "10.0.0",
    "postal-mime": "2.7.4",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "htmlparser2": "10.0.0",
    "postal-mime": "2.7.4"
  },
  "peerDependenciesMeta": {
    "htmlparser2": {
      "optional": true
    },
    "postal-mime": {
      "optional": true
    }
  }
}
